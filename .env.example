# Copy to .env and fill in. .env is gitignored -- never commit it.
#
# Get these from: supabase projects api-keys --project-ref <ref>
# or the dashboard: Project Settings -> API

SUPABASE_URL=https://qigiwthmigmwpbabznge.supabase.co
SUPABASE_PROJECT_REF=qigiwthmigmwpbabznge

# Safe to expose. This is the key the browser uses; RLS is what protects the
# data, not the secrecy of this string.
SUPABASE_ANON_KEY=

# SECRET. Bypasses row level security entirely. Server-side only -- never put
# this in web/, never commit it, never paste it into a chat.
SUPABASE_SERVICE_ROLE_KEY=
